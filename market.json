{
  "CanvasName": "demo1",
  "Assets": {
    "AppIcon": "market.png"
  },
  "Expression" : {
    "SpaceName": "demo1",
    
    "types": {
	  "mssql": {
		"TotalNum": "26",
		"ErrorNum": "0",
		"WarnningNum": "0",
		"RunningNum": "26"
	  },
	
	  "oracle": {
		"TotalNum": "30",
		"ErrorNum": "0",
		"WarnningNum": "0",
		"RunningNum": "30"
	  },
	
	  "mongodb": {
		"TotalNum": "9",
		"ErrorNum": "0",
		"WarnningNum": "0",
		"RunningNum": "9"
	  },
	  
	  "windows": {
		"TotalNum": "8",
		"ErrorNum": "0",
		"WarnningNum": "0",
		"RunningNum": "8"
	  },
	
	  "bvp": {
		"TotalNum": "6",
		"ErrorNum": "0",
		"WarnningNum": "2",
		"RunningNum": "5"
	  },
	  
	  "job": {
        "TotalNum": "123",
		"ErrorNum": "14",
		"WarnningNum": "20",
		"RunningNum": "98"
	  }
	},
    
    "AppTitle": "var_set name=appTitle value=\"Market Risk\" \n |",
    "DescName": "var_set name=descName value=\"Space:\" \n |",
    "DescValue": "var_set name=descValue value=$[SpaceName] \n |",
    "AppProperties": [{
      "Name": "var_set name=attrName value=\"Description:\" \n |",
      "Value": "var_set name=attrValue value=\"Market Risk Monitor\" \n |"
    }],
    "Summaries": [
      {
		"SummaryDbTitle": "\"Databases\"",
		"SummaryDbLabel": "\"Total Databases\"",
		"SummaryDbNum": "{math \"add($[types.mssql.TotalNum], $[types.oracle.TotalNum], $[types.mongodb.TotalNum])\"}",
		"SummaryDbErrorNum": "{math \"add($[types.mssql.ErrorNum], $[types.oracle.ErrorNum], $[types.mongodb.ErrorNum])\"}",
		"SummaryDbWarnningNum": "{math \"add($[types.mssql.WarnningNum], $[types.oracle.WarnningNum], $[types.mongodb.WarnningNum])\"}",
		"SummaryDbRunningNum": "{math \"add($[types.mssql.RunningNum], $[types.oracle.RunningNum], $[types.mongodb.RunningNum])\"}",
		"SummaryDbNum2": "{math \"add(1)\"}",
		"SummaryDbRunningNum2": "{essql query=\"SELECT sql.mmetrics.database_name from \\\"metrics*\\\" DESC Limit\"| math \"colname\"}",
        
        "Title": "var_set name=title value=$[SummaryDbTitle] \n |",
        "TotalLabel": "\"Jobs:\"",
        "TotalNum": "$[types.job.TotalNum]",
        "Error": "var_set name=count value=$[SummaryDbErrorNum] \n |",
        "Warnning": "var_set name=count value=$[SummaryDbWarnningNum] \n |",
        "Running": "var_set name=count value=$[SummaryDbRunningNum] \n |",
        "Attributes": [{
            "Name": "var_set name=attrName value=$[SummaryDbLabel] \n |", 
            "Value": "var_set name=attrValue value=$[SummaryDbNum] \n |"
          }
        ]
      },
      {
		"SummaryServerTitle": "\"Server Hosts\"",
		"SummaryServerLabel": "\"Total Server\"",
		"SummaryServerNum": "{math \"add($[types.windows.TotalNum], $[types.bvp.TotalNum])\"}",
		"SummaryServerErrorNum": "{math \"add($[types.windows.ErrorNum], $[types.bvp.ErrorNum])\"}",
		"SummaryServerWarnningNum": "{math \"add($[types.windows.WarnningNum], $[types.bvp.WarnningNum])\"}",
		"SummaryServerRunningNum": "{math \"add($[types.windows.RunningNum], $[types.bvp.RunningNum])\"}",
        
        "Title": "var_set name=title value=$[SummaryServerTitle] \n |",
        "Error": "var_set name=count value=$[SummaryServerErrorNum] \n |",
        "Warnning": "var_set name=count value=$[SummaryServerWarnningNum] \n |",
        "Running": "var_set name=count value=$[SummaryServerRunningNum] \n |",
        "Attributes": [{
            "Name": "var_set name=attrName value=$[SummaryServerLabel] \n |", 
            "Value": "var_set name=attrValue value=$[SummaryServerNum] \n |"
          }
        ]
      },
      {
		"SummaryJobTitle": "\"Jobs\"",
		"SummaryJobLabel": "\"Jobs\"",
		"SummaryJobNum": "{math \"add($[types.job.TotalNum])\"}",
		"SummaryJobErrorNum": "{math \"add($[types.job.ErrorNum])\"}",
		"SummaryJobWarnningNum": "{math \"add($[types.job.WarnningNum])\"}",
		"SummaryJobRunningNum": "{math \"add($[types.job.RunningNum])\"}",
        
        "Title": "var_set name=title value=$[SummaryJobTitle] \n |",
        "Error": "var_set name=count value=$[SummaryJobErrorNum] \n | var_set name=label_red_box value=\"Fail\" \n |",
        "Warnning": "var_set name=count value=$[SummaryJobWarnningNum] \n |",
        "Running": "var_set name=count value=$[SummaryJobRunningNum] \n | var_set name=label_green_box value=\"Success\" \n |",
        "Attributes": [{
            "Name": "var_set name=attrName value=$[SummaryJobLabel] \n |", 
            "Value": "var_set name=attrValue value=$[SummaryJobNum] \n |"
          }
        ]
      }
    ],
	"Histories": [
		{
			"Config": "embeddable \n  config=\"\" type=\"lens\"\n| render"
		}
	],
	"Components+": {
	    "Title": "var_set name=title value=\"[$[Name]]($[Url])\" \n |",
		"Error": "var_set name=count value=$[ErrorNum] \n | var_set name=url value=\"$[Url]\" \n |",
		"Warnning": "var_set name=count value=$[WarnningNum] \n | var_set name=url value=\"$[Url]\" \n |",
		"Running": "var_set name=count value=$[RunningNum] \n | var_set name=url value=\"$[Url]\" \n |",
        "Message": [ {"Content": "markdown \"\""}],
        "Attributes": [{
            "Name": "var_set name=attrName value=$[TotalLabel] \n |", 
            "Value": "var_set name=attrValue value=$[TotalNum] \n |"
          }      
        ]	
	},
    "Components": [ 
      {
		"sqlServerId": "workpad-900dc3d8-1140-4dbf-9b51-d8be439842c5",
        
        "Name": "SQL Server",
        "Url": "http://localhost:5601/s/demo1/app/canvas/workpad/$[sqlServerId]/page/1",
        "TotalLabel": "\"Databases:\"",
        "TotalNum": "$[types.mssql.TotalNum]",
		"ErrorNum": "$[types.mssql.ErrorNum]",
		"WarnningNum": "$[types.mssql.WarnningNum]",
		"RunningNum": "$[types.mssql.RunningNum]"
      },
      {
        "Name": "Oracle Server",
        "Url": "http://localhost",
        "TotalLabel": "\"Databases:\"",
        "TotalNum": "$[types.oracle.TotalNum]",
		"ErrorNum": "$[types.oracle.ErrorNum]",
		"WarnningNum": "$[types.oracle.WarnningNum]",
		"RunningNum": "$[types.oracle.RunningNum]"
      },
      {
        "Name": "MongoDB Server",
        "Url": "http://localhost",
        "TotalLabel": "\"Databases:\"",
        "TotalNum": "$[types.mongodb.TotalNum]",
		"ErrorNum": "$[types.mongodb.ErrorNum]",
		"WarnningNum": "$[types.mongodb.WarnningNum]",
		"RunningNum": "$[types.mongodb.RunningNum]"
      },
      {
        "Name": "Window Server",
        "Url": "http://localhost",
        "TotalLabel": "\"Servers:\"",
        "TotalNum": "$[types.windows.TotalNum]",
		"ErrorNum": "$[types.windows.ErrorNum]",
		"WarnningNum": "$[types.windows.WarnningNum]",
		"RunningNum": "$[types.windows.RunningNum]"
      },
      {
        "Name": "BVP Server",
        "Url": "http://localhost",
        "TotalLabel": "\"Servers:\"",
        "TotalNum": "$[types.bvp.TotalNum]",
		"ErrorNum": "$[types.bvp.ErrorNum]",
		"WarnningNum": "$[types.bvp.WarnningNum]",
		"RunningNum": "$[types.bvp.RunningNum]"
      },
      {
        "Name": "Jobs",
        "Url": "http://localhost",
        "TotalLabel": "\"Jobs:\"",
        "TotalNum": "$[types.job.TotalNum]",
		"ErrorNum": "$[types.job.ErrorNum]",
		"WarnningNum": "$[types.job.WarnningNum]",
		"RunningNum": "$[types.job.RunningNum]"
	  }
    ]
  }
}
